# ─────────────────────────────────────────────────────────────
# SALIN file ini menjadi .env lalu isi dengan nilai asli kamu
# cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Mode AI ──────────────────────────────────────────────────
# 'gemini-only'    → pakai Gemini langsung (untuk deploy online/Vercel)
# 'langflow-first' → pakai LangFlow dulu, fallback Gemini (untuk demo live lokal)
VITE_AI_MODE=gemini-only

# ── Google Gemini API Key (WAJIB) ────────────────────────────
# Dapatkan di: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── LangFlow Desktop (hanya untuk demo live lokal) ───────────
# Jalankan: bash start.sh --online
VITE_LANGFLOW_BASE_URL=/langflow-api
VITE_LANGFLOW_FLOW_ID=ecbe443a-cafc-4991-a25e-1fdee7d85b75
VITE_LANGFLOW_API_KEY=your_langflow_api_key_here
